{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FIRM scientific benchmark record v1",
  "type": "object",
  "required": ["schema_version", "id", "category", "prompt", "provenance", "grading"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "prompt": {"type": "string", "minLength": 1},
    "family_id": {"type": "string"},
    "provenance": {
      "type": "object", "required": ["kind", "review_status", "answers_public"],
      "properties": {
        "kind": {"enum": ["human_authored", "synthetic", "transformed", "literature_derived"]},
        "review_status": {"enum": ["unreviewed", "oracle_verified", "expert_reviewed"]},
        "answers_public": {"type": "boolean"},
        "source": {"type": "string"}, "license": {"type": "string"}
      }
    },
    "grading": {
      "type": "object", "required": ["quantities", "manual_rubric"],
      "properties": {
        "quantities": {"type": "object", "additionalProperties": {
          "type": "object", "required": ["value", "unit", "rtol", "atol"],
          "properties": {"value": {"type": "number"}, "unit": {"type": "string"},
                         "rtol": {"type": "number", "minimum": 0}, "atol": {"type": "number", "minimum": 0}}
        }},
        "manual_rubric": {"type": "array", "items": {"type": "string"}},
        "oracle": {"type": "string"}
      }
    }
  }
}
